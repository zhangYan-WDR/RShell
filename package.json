{
  "name": "rshell",
  "version": "1.0.0",
  "description": "RShell - 融合 Termius、WindTerm 与 Xshell 优秀特性的独立桌面终端客户端",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "package": "npm run build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder"
  },
  "keywords": [
    "ssh",
    "sftp",
    "terminal",
    "xshell",
    "termius",
    "windterm",
    "electron"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "0.344.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ssh2": "^1.17.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^30.5.1",
    "electron-builder": "24.13.3",
    "vite": "5.4.21"
  },
  "build": {
    "appId": "com.rshell.app",
    "productName": "RShell",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "ssh-manager.js",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    }
  }
}
